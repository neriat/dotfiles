// Generated from cmux session 2026-05-24. 11 tabs, mirrors cmux workspace order.
// Single-panel workspaces use a plain pane; multi-panel use `pane stacked=true`.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="MISC" {
        pane stacked=true {
            pane name="cc cost"                  cwd="/Users/neriatzidkani/Documents/repositories/deshraj/Claud-ometer"
            pane name="Claud-ometer"             cwd="/Users/neriatzidkani/Documents/repositories/deshraj/Claud-ometer"
            pane name="repositories"             cwd="/Users/neriatzidkani/Documents/repositories"
        }
    }

    tab name="PERSONAL" {
        pane stacked=true {
            pane name="c"           cwd="/Users/neriatzidkani/Documents/Personal/repositories/c"
            pane name="obsidian"    cwd="/Users/neriatzidkani/Documents/obsidian"
            pane name="fin-prompts" cwd="/Users/neriatzidkani/Documents/Personal/repositories/fin-prompts"
            pane name="fin-prompts" cwd="/Users/neriatzidkani/Documents/Personal/repositories/fin-prompts"
        }
    }

}
