#eval $(thefuck --alias)

alias q=claude
alias qw='claude --worktree'
alias resume_app='killall -CONT -c '
alias gipython='python $(which ipython_$(python -c "import sys; print(f\"{sys.version_info.major}{sys.version_info.minor}\")"))'
alias rfff='ruff format'
alias rc='ruff check --fix --show-fixes'
alias rucf='ruff check --show-fixes --fix "$@" && ruff format "$@"'
alias senv='set -a && source .env; set +a'
alias gblru='git for-each-ref --sort=-committerdate refs/heads/ --format="%(refname:short)" | head -n 5'
alias ggs='git log --oneline --graph --decorate origin/main HEAD'
alias gll='git pull --rebase origin main'
alias gcad='git commit --amend --no-edit'
alias ru='prun ruff format && ruff check --show-fixes --fix && mypy --config-file pyproject.toml .'
fix_env_dots() {
  local file="${1:-.env}"
  sed -i '' -E 's/\.([^=]*=)/__\1/g; s/\.([^=]*=)/__\1/g;
  s/\.([^=]*=)/__\1/g; s/\.([^=]*=)/__\1/g; s/\.([^=]*=)/__\1/g' "$file"
}

# Mac sleep utils
alias sleep_disable='sudo pmset -a disablesleep 1'
alias sleep_enable='sudo pmset -a disablesleep 0'
alias sleep_status='pmset -g | grep -qE "SleepDisabled[[:space:]]+1" && echo "sleep: disabled" || echo "sleep: enabled"'


