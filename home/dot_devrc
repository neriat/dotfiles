# airflow-blockaid's
render_sql() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: render_sql <sql_template> <json_file1> [<json_file2> ...]"
    echo "  | e.g. "
    echo "  | render_sql sql/dex_query_template.sql sql/jinja_mapping.json"
    echo "  | or copy to clipboard:"
    echo "  | render_sql sql/dex_query_template.sql sql/jinja_mapping.json | pbcopy"
    return 1
  fi

  local sql_template="$1"
  shift
  jq -s \
    --arg end "$(date -u +'%Y-%m-%dT%H:%M:%S+00:00')" \
    --arg start "$(date -u -v-15M +'%Y-%m-%dT%H:%M:%S+00:00')" \
    'def deep_merge(a; b):
      a as $a | b as $b
      | if ($a | type) == "object" and ($b | type) == "object"
        then
          reduce ($a + $b | keys_unsorted[]) as $key ({};
            if ($b | has($key))
            then .[$key] = deep_merge($a[$key]; $b[$key])
            else .[$key] = $a[$key]
            end)
        else $b
        end;
    reduce .[] as $item ({}; deep_merge(.; $item)) 
    | deep_merge(.; {data_interval_start: $start, data_interval_end: $end})' \
    "$@" | \
    jinja2 "$sql_template"
}


