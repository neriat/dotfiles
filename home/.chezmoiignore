.claude/debug
.claude/ide
.claude/jobs
.claude/run
.claude/daemon
.claude/daemon*
.claude/backups
.claude/_backups
.claude/chrome
.claude/statsig
.claude/todos
.claude/shell-snapshots
.claude/.last-*
.claude/*.bak
.claude/*.bak.*
