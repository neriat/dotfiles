#!/bin/sh
# Install Homebrew if it is missing. Runs before files are applied, because
# ~/.zprofile calls `brew shellenv` and ~/.config/zsh/00-path.zsh calls `brew --prefix`.
set -eu

if command -v brew >/dev/null 2>&1; then
    exit 0
fi
{{ if eq .chezmoi.os "darwin" -}}
[ -x /opt/homebrew/bin/brew ] && exit 0
{{- else -}}
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && exit 0
{{- end }}

echo "==> Homebrew not found; installing"
NONINTERACTIVE=1 /bin/bash -c \
  "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
