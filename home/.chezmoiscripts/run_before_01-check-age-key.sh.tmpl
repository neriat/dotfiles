{{- if eq (.chezmoi.config.encryption | default "") "age" -}}
#!/bin/sh
# Warn -- do not block -- when the age identity cannot decrypt this repo.
#
# .chezmoiignore has already removed the encrypted targets from this run, so the
# apply proceeds and everything else lands. This script exists only to say so
# out loud, because otherwise the omission is completely silent.
#
# ALWAYS exits 0. Blocking the apply is explicitly not wanted.
#
# The decision below mirrors the one in .chezmoiignore -- keep them in step.
# Absence is detected without dependencies; a wrong key only when age-keygen
# happens to be installed, because on a fresh machine the key is restored
# before Homebrew provides `age`.
set -eu

IDENTITY="{{ .chezmoi.config.age.identity }}"
EXPECTED="{{ .chezmoi.config.age.recipient }}"

REASON=""
if [ ! -f "$IDENTITY" ]; then
    REASON="no identity file at that path"
elif command -v age-keygen >/dev/null 2>&1; then
    ACTUAL=$(age-keygen -y "$IDENTITY" 2>/dev/null || true)
    if [ -n "$ACTUAL" ] && [ "$ACTUAL" != "$EXPECTED" ]; then
        REASON="the key there decrypts for $ACTUAL, not this repo"
    fi
fi

if [ -z "$REASON" ]; then
    # Key is usable. Tighten permissions if they have drifted, then stay quiet.
    if [ -f "$IDENTITY" ] && [ "$(stat -f '%Lp' "$IDENTITY" 2>/dev/null || echo 600)" != "600" ]; then
        echo "==> tightening permissions on $IDENTITY to 600" >&2
        chmod 600 "$IDENTITY"
    fi
    exit 0
fi

cat >&2 <<MSG

  ┌─ encrypted files SKIPPED this run ────────────────────────────────────┐
    Reason: $REASON
    Expected identity: $IDENTITY
    Repo encrypts to:  $EXPECTED

    Everything else was applied normally. These targets were left alone --
    existing copies on disk, if any, are untouched:
{{ range (glob (joinPath .chezmoi.sourceDir "**/encrypted_*")) }}
{{- $rel := trimSuffix ".age" (trimPrefix (printf "%s/" $.chezmoi.sourceDir) .) -}}
{{- $out := list -}}
{{- range (splitList "/" $rel) -}}
{{-   $s := trimPrefix "private_" (trimPrefix "encrypted_" .) -}}
{{-   if hasPrefix "dot_" $s }}{{ $s = printf ".%s" (trimPrefix "dot_" $s) }}{{ end -}}
{{-   $out = append $out $s -}}
{{- end }}
      ~/{{ join "/" $out }}
{{- end }}

    To get them: restore your backed-up private key to
        $IDENTITY
    then  chmod 600  it and re-run  chezmoi apply
  └───────────────────────────────────────────────────────────────────────┘

MSG
exit 0
{{- end }}
