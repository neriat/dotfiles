#!/bin/sh
# Install packages from the Brewfiles at the repo root.
#
# The hashes below are what make `run_onchange_` fire: chezmoi re-runs this
# script whenever its rendered content changes, so editing either Brewfile
# changes a hash, which changes this file, which re-runs the install.
#   Brewfile        hash: {{ include "../Brewfile" | sha256sum }}
{{- if eq .chezmoi.os "darwin" }}
#   Brewfile.darwin hash: {{ include "../Brewfile.darwin" | sha256sum }}
{{- end }}
{{- if and (eq .chezmoi.os "darwin") (eq .profile "work") }}
#   Brewfile.work   hash: {{ include "../Brewfile.work" | sha256sum }}
{{- end }}
set -eu

SRC="{{ .chezmoi.sourceDir }}/.."

# Many GUI apps on an existing machine were installed by hand (dragged from a
# .dmg), so Homebrew does not own them and would abort with "It seems there is
# already an App at ...". --adopt makes brew take over the existing bundle in
# place instead. No-op on a clean machine. Adoption is refused when the on-disk
# artifact differs from the cask version -- fix those individually, don't --force
# blindly.
export HOMEBREW_CASK_OPTS="--adopt"

if ! command -v brew >/dev/null 2>&1; then
{{ if eq .chezmoi.os "darwin" -}}
    eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else -}}
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}
fi

echo "==> brew bundle: Brewfile"
brew bundle --file="$SRC/Brewfile" --no-upgrade
{{ if eq .chezmoi.os "darwin" }}
echo "==> brew bundle: Brewfile.darwin"
brew bundle --file="$SRC/Brewfile.darwin" --no-upgrade
{{- end }}
{{ if and (eq .chezmoi.os "darwin") (eq .profile "work") }}
echo "==> brew bundle: Brewfile.work (profile=work)"
brew bundle --file="$SRC/Brewfile.work" --no-upgrade
{{- end }}
